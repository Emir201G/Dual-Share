<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- 🌙 Tema base -->
    <style name="Theme.DualShare" parent="Theme.Material3.Light.NoActionBar">

        <!-- 🎨 Colores principales -->
        <item name="colorPrimary">@color/bright_sky_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/bright_sky_blue</item>

        <!-- 🎨 Colores secundarios -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- 🎨 Superficies (IMPORTANTE para que sea BLANCO) -->
        <item name="colorSurface">@color/white</item>
        <item name="colorSurfaceVariant">@color/ultra_ligth_gray</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="colorSurfaceContainer">@color/white</item>
        <item name="colorSurfaceContainerHigh">@color/white</item>

        <!-- 🧭 Barras -->
        <item name="android:statusBarColor">@color/bright_sky_blue</item>
        <item name="android:navigationBarColor">@color/white</item>

        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- 🪟 Ventana -->
        <item name="android:windowBackground">@color/white</item>

        <!-- ✨ Sombras / bordes -->
        <item name="colorOutline">@color/light_gray</item>
        <item name="android:shadowColor">@color/light_gray</item>

    </style>

</resources>
