<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ultra_ligth_gray"
    android:padding="12dp">

    <!-- 🔥 CABECERA PERFECTA -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        android:elevation="0dp"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/text_title_dual"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DUAL"
            android:fontFamily="@font/league_gothic_regular"
            android:textSize="42sp"
            android:textColor="@color/black"/>

        <TextView
            android:id="@+id/text_title_share"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SHARE"
            android:fontFamily="@font/league_gothic_regular"
            android:textSize="72sp"
            android:textColor="@color/white"

            android:shadowColor="#55000000"
            android:shadowDx="0"
            android:shadowDy="3"
            android:shadowRadius="8"

            android:layout_marginTop="-6dp"/>


        <ImageView
            android:id="@+id/image_logo_main"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/logo_dual_share"/>
    </LinearLayout>

    <!-- 🔥 TABLAYOUT SIN LÍNEA GRIS + MODERNO -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="6dp"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        app:tabIndicatorHeight="0dp"
        app:tabRippleColor="@android:color/transparent"
        app:tabBackground="@drawable/tab_item_background"
        app:tabTextColor="@color/tab_text_color"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Generar Código"/>

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ingresar Código"/>

    </com.google.android.material.tabs.TabLayout>||

    <!-- 🔥 VIEWPAGER PERFECTAMENTE ADAPTADO -->
    <androidx.viewpager2.widget.ViewPager2
        android:background="@android:color/transparent"
        android:id="@+id/viewPager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/tabLayout"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
