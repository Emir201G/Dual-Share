<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- 🌙 TEMA PRINCIPAL DE LA APP -->
    <style name="Theme.DualShare" parent="Theme.Material3.Light.NoActionBar">

        <item name="android:windowIsTranslucent">true</item>
        
        <!-- 🎨 Colores principales -->
        <item name="colorPrimary">@color/bright_sky_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/bright_sky_blue</item>

        <!-- 🎨 Colores secundarios -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- 🧱 Superficies (pantallas blancas si no los controlas) -->
        <item name="colorSurface">@color/white</item>
        <item name="colorSurfaceVariant">@color/ultra_ligth_gray</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="colorSurfaceContainer">@color/white</item>
        <item name="colorSurfaceContainerHigh">@color/white</item>

        <!-- 🧭 Barras -->
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>

        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- 🪟 Fondo general -->
        <item name="android:windowBackground">@color/white</item>

        <!-- ✨ Sombras / Outline -->
        <item name="colorOutline">@color/light_gray</item>
        <item name="android:shadowColor">@color/light_gray</item>

    </style>



    <!-- 🚀 TEMA PARA EL SPLASH SCREEN (CORRIGE LA PANTALLA BLANCA) -->

</resources>
