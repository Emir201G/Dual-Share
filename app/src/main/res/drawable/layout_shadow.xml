<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Sombra suave en todos los lados -->
    <item
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp">
        <shape android:shape="rectangle">
            <solid android:color="#88000000" /> <!-- más visible pero sin exagerar -->
            <corners android:radius="20dp" />
        </shape>
    </item>

    <!-- Fondo principal -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>

</layer-list>
