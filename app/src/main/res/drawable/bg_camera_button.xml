<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@android:color/white" />
    <size
        android:width="36dp"
        android:height="36dp" />
    <padding
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp" />
    <corners android:radius="50dp" />

    <stroke android:color="@android:color/black" android:width="1dp"/>
</shape>
