<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 🔹 Estado seleccionado -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/black" />
            <corners android:radius="16dp" />
            <!-- 🌟 Pequeña sombra exterior -->
            <padding android:bottom="2dp" />
            <stroke android:width="1dp" android:color="@color/white" />
        </shape>
    </item>

    <!-- 🔹 Estado no seleccionado (con sombreado interno simulado) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <corners android:radius="16dp" />
            <!-- 🌫️ Degradado para simular sombra interna -->
            <gradient
                android:startColor="#FBFBFB"
                android:centerColor="#FDFDFD"
                android:endColor="#FAF9F9"
                android:angle="270" />
            <!-- Borde sutil -->
            <stroke android:width="1dp" android:color="#F8F8F8" />
        </shape>
    </item>

</selector>
