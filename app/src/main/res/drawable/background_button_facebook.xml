<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- sombra alrededor del botón -->
    <item
        android:bottom="44dp"
        android:left="44dp"
        android:right="44dp"
        android:top="44dp">
        <shape android:shape="rectangle">
            <solid android:color="#CC1AFD80" /> <!-- sombra oscura -->
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- botón blanco -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/royal_blue" />
            <corners android:radius="12dp" />
        </shape>
    </item>

</layer-list>
