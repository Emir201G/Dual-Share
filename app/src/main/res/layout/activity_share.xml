<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ultra_ligth_gray"
    android:padding="12dp">

    <!-- 🔥 CABECERA PERFECTA -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/image_logo_main"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/logo_dual_share" />

        <TextView
            android:id="@+id/text_title_dual"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-30dp"
            android:layout_marginBottom="30dp"
            android:fontFamily="@font/pacifico_regular"
            android:shadowColor="@color/white"
            android:shadowDx="0"
            android:shadowDy="3"
            android:shadowRadius="8"
            android:text="Dual Share"
            android:textColor="@color/black"
            android:textSize="42sp" />

        <!--        <TextView-->
        <!--            android:id="@+id/text_title_share"-->
        <!--            android:layout_width="wrap_content"-->
        <!--            android:layout_height="wrap_content"-->
        <!--            android:text="SHARE"-->
        <!--            android:fontFamily="@font/league_gothic_regular"-->
        <!--            android:textSize="72sp"-->
        <!--            android:textColor="@color/white"-->

        <!--            android:shadowColor="#55000000"-->
        <!--            android:shadowDx="0"-->
        <!--            android:shadowDy="3"-->
        <!--            android:shadowRadius="8"-->

        <!--            android:layout_marginTop="-6dp"/>-->
    </LinearLayout>

    <!-- 🔥 TABLAYOUT SIN LÍNEA GRIS + MODERNO -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        android:padding="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:tabBackground="@drawable/tab_item_background"
        app:tabIndicatorHeight="0dp"
        app:tabRippleColor="@android:color/transparent"
        app:tabTextColor="@color/tab_text_color">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Generar Código" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ingresar Código" />

    </com.google.android.material.tabs.TabLayout>

    <!-- 🔥 VIEWPAGER PERFECTAMENTE ADAPTADO -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabLayout" />
</androidx.constraintlayout.widget.ConstraintLayout>
